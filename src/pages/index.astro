---
import Base from '../layouts/Base.astro'
import AdSlot from '../components/AdSlot.astro'
import Icon from '../components/Icon.astro'
import { TOOLS, SITE, photo } from '../config.js'

const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: `https://${SITE.domain}`, description: SITE.tagline, inLanguage: 'es-ES' }
---
<Base
  title="Herramientas gratis para fotos y textos de redes – ToolBoxViral"
  description="Quita el fondo de una foto, convierte HEIC a JPG, comprime imágenes, adáptalas a Reels, TikTok y YouTube y cuenta palabras. Gratis y sin subir tus archivos."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="hero relative isolate text-white">
    <div class="absolute inset-0 -z-10 overflow-hidden"><img src={photo('/')} alt="" class="hero-img absolute inset-0 h-full w-full object-cover" fetchpriority="high" /><video class="hero-img hero-video absolute inset-0 h-full w-full object-cover" data-src="/video/hero.mp4" muted loop playsinline preload="none" aria-hidden="true"></video></div>
    <div class="mist" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-950/95 via-brand-950/80 to-brand-900/40"></div>
    <div class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:pt-20 sm:pb-24">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold ring-1 ring-white/15 backdrop-blur">
        <Icon name="sparkles" size={14} class="text-gold-300" /> Gratis, sin registro y sin marca de agua
      </p>
      <h1 class="mt-5 max-w-3xl font-display text-5xl leading-[1.02] font-extrabold tracking-tight sm:text-6xl">
        Tus fotos y textos, <span class="bg-gradient-to-r from-brand-300 to-gold-300 bg-clip-text text-transparent">listos para publicar.</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-brand-100/90">Quita fondos, convierte, comprime y adapta tus imágenes a cada red. Todo en tu navegador: tus archivos no se suben a ningún sitio.</p>
      <div class="mt-8 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4">
        {TOOLS.map((t) => (
          <a href={t.path} class="group flex flex-col gap-3 rounded-2xl bg-white/10 p-4 ring-1 ring-white/15 backdrop-blur transition hover:-translate-y-1 hover:bg-white hover:text-brand-900">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/15 text-white transition group-hover:bg-brand-600"><Icon name={t.icon} size={20} /></span>
            <span class="font-display leading-tight font-bold">{t.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <section id="herramientas" class="scroll-mt-24 pt-12">
      <h2 class="font-display text-3xl font-extrabold tracking-tight">Todas las herramientas</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
        {TOOLS.map((t) => (
          <a href={t.path} class="group flex items-center gap-3 overflow-hidden rounded-2xl bg-white p-2 ring-1 ring-stone-900/5 transition hover:-translate-y-1 sm:block sm:rounded-3xl sm:p-0 hover:shadow-xl hover:shadow-brand-900/10 dark:bg-white/5 dark:ring-white/10">
            <div class="relative h-16 w-20 shrink-0 overflow-hidden rounded-xl bg-brand-100 sm:aspect-[3/2] sm:h-auto sm:w-auto sm:rounded-none">
              <img src={photo(t.path)} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <span class="absolute bottom-3 left-3 hidden h-10 w-10 place-items-center rounded-xl bg-white/95 text-brand-700 shadow sm:grid"><Icon name={t.icon} size={20} /></span>
            </div>
            <div class="min-w-0 sm:p-5">
              <h3 class="flex items-center justify-between gap-2 font-display font-bold sm:text-lg group-hover:text-brand-700 dark:group-hover:text-brand-300">{t.title}<Icon name="arrow-right" size={18} class="shrink-0 text-brand-600 transition group-hover:translate-x-1" /></h3>
              <p class="mt-0.5 line-clamp-1 text-sm text-stone-500 sm:mt-1 sm:line-clamp-none dark:text-stone-400">{t.blurb}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <ul class="mt-12 hidden gap-4 rounded-3xl bg-brand-950 p-6 sm:grid text-sm text-brand-100 sm:grid-cols-3 sm:p-8">
      {[['shield-check', 'Privado', 'Tus fotos y textos se procesan en tu dispositivo'], ['badge-check', 'Sin marca de agua', 'Descarga el resultado limpio, siempre gratis'], ['smartphone', 'En el móvil', 'Funciona en el navegador, sin instalar nada']].map(([i, t, d]) => (
        <li class="flex gap-3"><Icon name={i} size={22} class="mt-0.5 shrink-0 text-gold-300" /><span><strong class="block text-white">{t}</strong>{d}</span></li>
      ))}
    </ul>

    <AdSlot slot="content" minHeight={280} class="mt-10 mb-4 max-w-3xl" />
  </div>
</Base>
