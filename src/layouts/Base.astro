---
import '../styles/global.css'
import Icon from '../components/Icon.astro'
import Logo from '../components/Logo.astro'
import { SITE, ADSENSE, TOOLS, CATEGORIAS } from '../config.js'

const { title, description } = Astro.props
const here = Astro.url.pathname.replace(/(index)?\.html$/, '') || '/'
const canonical = new URL(here, Astro.site)
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#1e0b47" />
    {ADSENSE.client && <meta name="google-adsense-account" content={ADSENSE.client} />}
    {ADSENSE.client && (
      <script async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`}></script>
    )}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme')
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark')
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-brand-900 focus:px-3 focus:py-2 focus:text-white">Saltar al contenido</a>
    <header class="sticky top-0 z-40 border-b border-stone-900/5 bg-paper/80 backdrop-blur-md dark:border-white/5 dark:bg-night/80">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4">
        <a href="/" aria-label="ToolBoxViral, inicio"><Logo size={42} /></a>

        <nav aria-label="Herramientas" class="ml-auto hidden items-center gap-0.5 text-[0.92rem] whitespace-nowrap lg:flex">
          {TOOLS.filter((c) => c.nav).map((c) => (
            <a
              href={c.path}
              aria-current={here === c.path ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-1.5 transition',
                here === c.path
                  ? 'bg-brand-900 font-medium text-white dark:bg-brand-700'
                  : 'text-stone-600 hover:bg-stone-900/5 hover:text-stone-900 dark:text-stone-300 dark:hover:bg-white/5 dark:hover:text-white',
              ]}
            >{c.label}</a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-1 lg:ml-2">
          <button id="theme-toggle" class="grid h-10 w-10 place-items-center rounded-full text-stone-600 transition hover:bg-stone-900/5 dark:text-stone-300 dark:hover:bg-white/10" aria-label="Cambiar entre modo claro y oscuro">
            <span class="hidden dark:block"><Icon name="sun" size={19} /></span>
            <span class="dark:hidden"><Icon name="moon" size={19} /></span>
          </button>
          <details class="group relative">
            <summary class="flex h-10 cursor-pointer list-none items-center gap-2 rounded-full bg-brand-900 px-4 text-sm font-medium text-white transition hover:bg-brand-800 dark:bg-brand-700 [&::-webkit-details-marker]:hidden">
              <span class="group-open:hidden"><Icon name="menu" size={17} /></span>
              <span class="hidden group-open:block"><Icon name="x" size={17} /></span>
              <span class="hidden sm:inline">Herramientas</span><span class="sr-only sm:hidden">Herramientas</span>
            </summary>
            <div class="absolute right-0 mt-3 w-[min(92vw,640px)] rounded-3xl border border-stone-900/5 bg-white p-3 shadow-2xl shadow-brand-950/10 dark:border-white/10 dark:bg-stone-900">
              <div class="grid gap-1 sm:grid-cols-2">
                {CATEGORIAS.map((cat, i) => (
                  <div class="p-2">
                    <p class="px-2 pb-1 text-xs font-semibold tracking-wider text-stone-400 uppercase">{cat}</p>
                    {TOOLS.filter((c) => c.cat === i).map((c) => (
                      <a href={c.path} class="flex items-center gap-3 rounded-xl px-2 py-2 text-sm transition hover:bg-brand-50 dark:hover:bg-white/5">
                        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300"><Icon name={c.icon} size={17} /></span>
                        <span class="font-medium">{c.label}</span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="contenido" class="flex-1"><slot /></main>

    <footer class="mt-12 sm:mt-20 bg-brand-950 text-brand-100">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:py-14 md:grid-cols-[1.6fr_1fr_1fr]">
        <div>
          <Logo dark />
          <p class="mt-3 max-w-xs text-sm leading-relaxed text-brand-200/80">
            {SITE.tagline}
          </p>
          <ul class="mt-5 space-y-2 text-sm text-brand-200/90">
            <li class="flex items-center gap-2"><Icon name="badge-check" size={16} class="text-gold-300" /> Sin marca de agua ni registro</li>
            <li class="flex items-center gap-2"><Icon name="lock" size={16} class="text-gold-300" /> Tus archivos no salen de tu dispositivo</li>
          </ul>
        </div>
        {CATEGORIAS.map((cat, i) => (
          <nav aria-label={cat} class="hidden md:block">
            <p class="text-sm font-semibold text-white">{cat}</p>
            <ul class="mt-3 space-y-2 text-sm text-brand-200/80">
              {TOOLS.filter((c) => c.cat === i).map((c) => <li><a class="transition hover:text-white" href={c.path}>{c.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-brand-200/70 sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} {SITE.domain}</p>
          <nav aria-label="Información legal" class="flex flex-wrap gap-x-5 gap-y-2">
            <a class="hover:text-white" href="/sobre-nosotros">Sobre nosotros</a>
            <a class="hover:text-white" href="/contacto">Contacto</a>
            <a class="hover:text-white" href="/aviso-legal">Aviso legal</a>
            <a class="hover:text-white" href="/politica-de-privacidad">Privacidad</a>
            <a class="hover:text-white" href="/politica-de-cookies">Cookies</a>
          </nav>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var dark = document.documentElement.classList.toggle('dark')
        try { localStorage.setItem('theme', dark ? 'dark' : 'light') } catch (e) {}
      })
      // Cierra el menú al pulsar fuera o Escape
      document.addEventListener('click', function (e) {
        document.querySelectorAll('header details[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open') })
      })
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') document.querySelectorAll('header details[open]').forEach(function (d) { d.removeAttribute('open') })
      })
    </script>
    <script>
      import '../scripts/motion.js'
    </script>
  </body>
</html>
