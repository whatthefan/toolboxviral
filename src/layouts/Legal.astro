---
import Base from './Base.astro'
import { SITE } from '../config.js'
const { title, description, showUpdated = true } = Astro.props
---
<Base title={`${title} – ${SITE.name}`} description={description}>
  <section class="bg-grid border-b border-stone-900/5 dark:border-white/5">
    <div class="mx-auto max-w-3xl px-4 py-12">
      <h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
      {showUpdated && <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">Última actualización: {SITE.updated}</p>}
    </div>
  </section>
  <article class="article mx-auto max-w-3xl px-4 py-10">
    <slot />
  </article>
</Base>
