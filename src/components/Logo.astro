---
// Logo de ToolBoxViral: una caja de herramientas con un botón de play (contenido) y destellos (lo que se vuelve viral).
const { dark = false, size = 36 } = Astro.props
const id = `tb${Math.random().toString(36).slice(2, 7)}`
---
<span class="inline-flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" class="shrink-0 drop-shadow-sm">
    <defs>
      <linearGradient id={`${id}b`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7c3aed" /><stop offset="0.55" stop-color="#a21caf" /><stop offset="1" stop-color="#db2777" /></linearGradient>
    </defs>
    <rect width="40" height="40" rx="11" fill={`url(#${id}b)`} />
    <Fragment set:html={`<rect x="1" y="1" width="38" height="18" rx="10" fill="#fff" opacity="0.12"/><path d="M15.4 14.2v-1.9a2.3 2.3 0 0 1 2.3-2.3h4.6a2.3 2.3 0 0 1 2.3 2.3v1.9" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round"/><rect x="8.6" y="14" width="22.8" height="17.6" rx="3.6" fill="#fff"/><path d="M8.6 17.6a3.6 3.6 0 0 1 3.6-3.6h15.6a3.6 3.6 0 0 1 3.6 3.6v1.6H8.6z" fill="#ede9fe"/><path d="M8.6 19.2h22.8" stroke="#c4b5fd" stroke-width="1.2"/><path d="M18.2 22.3v6.4l5.7-3.2z" fill="#7c3aed" stroke="#7c3aed" stroke-width="1.2" stroke-linejoin="round"/><path d="M29.6 9.6l2.6-2.6M31.4 12.6h3.4M27.4 7.6V4.4" stroke="#fde047" stroke-width="2" stroke-linecap="round"/>`} />
  </svg>
  <span class:list={['font-display text-[1.3rem] leading-none font-extrabold tracking-tight', dark ? 'text-white' : 'text-stone-900 dark:text-white']}>ToolBox<span class:list={['bg-gradient-to-r bg-clip-text text-transparent', dark ? 'from-brand-300 to-gold-300' : 'from-brand-600 to-gold-500 dark:from-brand-300 dark:to-gold-300']}>Viral</span></span>
</span>
