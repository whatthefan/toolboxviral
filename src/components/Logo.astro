---
// Logo de ToolBoxViral: una caja en 3D (la caja de herramientas) con la T y la B en sus caras y el destello de la IA encima.
const { dark = false, size = 36 } = Astro.props
const id = `tb${Math.random().toString(36).slice(2, 7)}`
---
<span class="inline-flex items-center gap-2">
  <svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" class="shrink-0 drop-shadow-md">
    <defs set:html={`<linearGradient id="${id}t" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#a78bfa"/><stop offset="1" stop-color="#8b5cf6"/></linearGradient><linearGradient id="${id}l" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7c3aed"/><stop offset="1" stop-color="#5b21b6"/></linearGradient><linearGradient id="${id}r" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#db2777"/><stop offset="1" stop-color="#9d174d"/></linearGradient>`} />
    <Fragment set:html={`<path d="M24 5 41 14.8 24 24.6 7 14.8Z" fill="url(#${id}t)"/><path d="M7 14.8 24 24.6V44L7 34.2Z" fill="url(#${id}l)"/><path d="M24 24.6 41 14.8V34.2L24 44Z" fill="url(#${id}r)"/><path d="M24 24.6V44" stroke="#fff" stroke-opacity=".18" stroke-width=".6"/><path d="M7 14.8 24 24.6 41 14.8" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width=".6"/><g transform="matrix(1.0625 .6125 0 1.2125 7 14.8)"><path d="M3 3.2H13V6.2H9.6V14H6.4V6.2H3Z" fill="#fff"/></g><g transform="matrix(1.0625 -.6125 0 1.2125 24 24.6)"><path fill="#fff" fill-rule="evenodd" d="M3.5 2.6H9.6C11.9 2.6 13.2 3.9 13.2 5.6 13.2 6.7 12.6 7.5 11.8 8 12.9 8.4 13.7 9.4 13.7 10.8 13.7 12.8 12.2 14 9.9 14H3.5ZM6.5 5.2V7H9.1C9.8 7 10.2 6.6 10.2 6.1 10.2 5.6 9.8 5.2 9.1 5.2ZM6.5 9.4V11.4H9.5C10.3 11.4 10.7 11 10.7 10.4 10.7 9.8 10.3 9.4 9.5 9.4Z"/></g><path d="M24 9.6C24.5 12.6 25.3 13.4 28.6 14.8 25.3 16.2 24.5 17 24 20 23.5 17 22.7 16.2 19.4 14.8 22.7 13.4 23.5 12.6 24 9.6Z" fill="#fde047"/>`} />
  </svg>
  <span class:list={['font-display text-[1.3rem] leading-none font-extrabold tracking-tight', dark ? 'text-white' : 'text-stone-900 dark:text-white']}>ToolBox<span class:list={['bg-gradient-to-r bg-clip-text text-transparent', dark ? 'from-brand-300 to-gold-300' : 'from-brand-600 to-gold-500 dark:from-brand-300 dark:to-gold-300']}>Viral</span></span>
</span>
