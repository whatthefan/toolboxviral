---
// Logo de ToolBoxViral: la T y la B unidas en un solo trazo, con la etiqueta AI y un destello.
const { dark = false, size = 36 } = Astro.props
const id = `tb${Math.random().toString(36).slice(2, 7)}`
---
<span class="inline-flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" class="shrink-0 drop-shadow-sm">
    <defs set:html={`<linearGradient id="${id}g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6d28d9"/><stop offset=".55" stop-color="#a21caf"/><stop offset="1" stop-color="#e11d48"/></linearGradient><linearGradient id="${id}h" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#f3e8ff"/></linearGradient>`} />
    <rect width="48" height="48" rx="13" fill={`url(#${id}g)`} />
    <Fragment set:html={`<path d="M1.5 14C1.5 7 7 1.5 14 1.5h20C41 1.5 46.5 7 46.5 14v2C33 11.5 15 11.5 1.5 19z" fill="#fff" opacity=".08"/><path fill="url(#${id}h)" fill-rule="evenodd" d="M11 10H27C31.4 10 34 12.8 34 16.6C34 19.2 32.6 21.3 30.5 22.3C33.4 23.2 35.5 25.9 35.5 29.4C35.5 34.1 32.2 38 27 38H19.5C17.6 38 16 36.4 16 34.5V16H11C9.3 16 8 14.7 8 13C8 11.3 9.3 10 11 10ZM22 15.8H26C27.5 15.8 28.5 16.8 28.5 18.1C28.5 19.4 27.5 20.4 26 20.4H22ZM22 25.6H27C28.9 25.6 30 26.9 30 29.1C30 31.3 28.9 32.6 27 32.6H22Z"/><rect x="28.5" y="31" width="16" height="12" rx="4.2" fill="#fde047" stroke="#be185d" stroke-width="2"/><path d="M32 40.4L34.4 34.2L36.8 40.4M32.9 38.3H35.9M40.6 34.2V40.4" fill="none" stroke="#4c1d95" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="M39.5 5.5C39.9 8.6 40.4 9.1 43.5 9.5C40.4 9.9 39.9 10.4 39.5 13.5C39.1 10.4 38.6 9.9 35.5 9.5C38.6 9.1 39.1 8.6 39.5 5.5Z" fill="#fde047"/>`} />
  </svg>
  <span class:list={['font-display text-[1.3rem] leading-none font-extrabold tracking-tight', dark ? 'text-white' : 'text-stone-900 dark:text-white']}>ToolBox<span class:list={['bg-gradient-to-r bg-clip-text text-transparent', dark ? 'from-brand-300 to-gold-300' : 'from-brand-600 to-gold-500 dark:from-brand-300 dark:to-gold-300']}>Viral</span></span>
</span>
