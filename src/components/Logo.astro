---
// Logo de ToolBoxViral: una caja de herramientas de la que salta una chispa (lo que se vuelve viral).
const { dark = false, size = 36 } = Astro.props
const id = `tb${Math.random().toString(36).slice(2, 7)}`
---
<span class="inline-flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" class="shrink-0 drop-shadow-sm">
    <defs>
      <linearGradient id={`${id}b`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8b5cf6" /><stop offset="1" stop-color="#db2777" /></linearGradient>
    </defs>
    <rect width="40" height="40" rx="11" fill={`url(#${id}b)`} />
    <rect x="1" y="1" width="38" height="18" rx="10" fill="#fff" opacity="0.1" />
    <path d="M15 16v-2.2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2V16" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
    <rect x="8.5" y="16" width="23" height="15" rx="3.2" fill="#fff" />
    <path d="M8.5 22.2h23" stroke="#c026d3" stroke-width="1.6" />
    <rect x="18" y="20.4" width="4" height="3.6" rx="1" fill="#7c3aed" />
    <path d="M30.5 5.5l.9 2.3 2.3.9-2.3.9-.9 2.3-.9-2.3-2.3-.9 2.3-.9z" fill="#fde68a" />
  </svg>
  <span class:list={['font-display text-[1.3rem] leading-none font-extrabold tracking-tight', dark ? 'text-white' : 'text-stone-900 dark:text-white']}>ToolBox<span class:list={['bg-gradient-to-r bg-clip-text text-transparent', dark ? 'from-brand-300 to-gold-300' : 'from-brand-600 to-gold-500 dark:from-brand-300 dark:to-gold-300']}>Viral</span></span>
</span>
