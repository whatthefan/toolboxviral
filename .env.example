# AdSense. Set these in Cloudflare Pages → your project → Settings → Variables and secrets,
# then redeploy. Leave them empty until AdSense approves the site.
#
# Only PUBLIC_ADSENSE_CLIENT is required: it adds the AdSense script, the site-verification
# meta tag and a correct /ads.txt. With just this, "Auto ads" in AdSense will place ads for you.
# The three slot IDs are optional: create "Display" ad units in AdSense and paste their IDs to
# also use the reserved ad spaces in the page layout.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_AD_SLOT_TOP=
PUBLIC_AD_SLOT_CONTENT=
PUBLIC_AD_SLOT_SIDEBAR=
